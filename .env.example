# Copy these values into your private Vercel project environment settings.
# Never commit real service keys or passwords.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ARLA_STAFF_EMAILS=

# Required before checkout can accept orders. Use the percentage confirmed for ARLA.
ARLA_TAX_RATE=
# Required: whether the configured tax rate applies to the delivery fee.
ARLA_TAX_DELIVERY=

# Standard delivery fee: $2.99 (299 cents). A delivery zone may override this
# if ARLA sets a different fee for that specific area.
ARLA_DELIVERY_FEE_CENTS=299

# Add only ZIP codes that ARLA has confirmed are in its delivery coverage.
# Optional per-zone feeCents and required minimumCents use integer cents.
# Leave [] to keep delivery unavailable until coverage is verified.
ARLA_DELIVERY_ZONES=[]

# Stripe test mode only. The server rejects live secret keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public HTTPS base URL used for trusted Stripe success/cancel redirects.
PUBLIC_SITE_URL=https://www.thearla.com
